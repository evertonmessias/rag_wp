# Segredos e dados locais (nunca sobem para o GitHub)
.env
*.sql
*.sql.gz
*.dump
!postgres/init/*.sql

# Wordpress - ignore:
wordpress/bkp
wordpress/stats
wordpress/wp-admin
wordpress/wp-includes
wordpress/wp-content/a*
wordpress/wp-content/l*
wordpress/wp-content/w*
wordpress/wp-content/*.php
wordpress/wp-content/*.log
wordpress/wp-content/themes/index.php
wordpress/w*.php
!wordpress/wp-config.php
wordpress/index.php
wordpress/xmlrpc.php
wordpress/*.bkp
wordpress/*.txt
wordpress/*.html
wordpress/*.sql

# Uploads (PDFs anexados aos posts e mídia): ficam só no servidor
wordpress/wp-content/uploads/

# Plugins: só o rag_wp vai para o GitHub (os demais são instalados pelo painel)
wordpress/wp-content/plugins/*
!wordpress/wp-content/plugins/rag_wp/

# Logs do plugin (gerados no servidor, não sobem no commit)
wordpress/wp-content/plugins/rag_wp/includes/src/logs/*.log

# Chat de IA (wordpress/ia): o código vai para o Git; logs e cache gerados no servidor, não
wordpress/ia/*.log
wordpress/ia/debug.txt
__pycache__/

# Temas e pastas de atualização do WordPress: recriados pelo próprio WordPress, não vão para o Git
wordpress/wp-content/themes/
wordpress/wp-content/upgrade/
wordpress/wp-content/upgrade-temp-backup/
